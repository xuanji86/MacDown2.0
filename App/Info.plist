<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
				<string>public.markdown</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Quarto Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.quarto.qmd</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.xuanji86.MacDown2.tab</string>
			<key>UTTypeDescription</key>
			<string>MacDown2 Tab</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<!-- public.markdown is not declared by macOS (checked on 26/27: `UTType("public.markdown")` is nil and no installed bundle
		     declares it), but other apps tag files with it. Imported, never exported: the public.* namespace is Apple's. It is an
		     alias of net.daringfireball.markdown with no extensions of its own, so `.md` keeps resolving to the one type. -->
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.markdown</string>
			<key>UTTypeDescription</key>
			<string>Markdown Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.daringfireball.markdown</string>
			<key>UTTypeDescription</key>
			<string>Markdown Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>md</string>
					<string>markdown</string>
					<string>mdown</string>
					<string>mkd</string>
					<string>mkdn</string>
					<string>mdwn</string>
					<string>mdtxt</string>
					<string>mdtext</string>
					<string>text</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/markdown</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.quarto.qmd</string>
			<key>UTTypeDescription</key>
			<string>Quarto Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>qmd</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/x-quarto-markdown</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Purpose strings of the system's file-access prompts, shown when the file tree browses these places. English here,
	     Simplified Chinese in zh-Hans.lproj/InfoPlist.strings. iCloud Drive has no key of its own: a cloud provider's files
	     (iCloud Drive, Dropbox, ...) are covered by NSFileProviderDomainUsageDescription. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>MacDown2 shows the Markdown files in your Desktop folder in its file tree.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>MacDown2 shows the Markdown files in your Documents folder in its file tree.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>MacDown2 shows the Markdown files in your Downloads folder in its file tree.</string>
	<key>NSFileProviderDomainUsageDescription</key>
	<string>MacDown2 shows the Markdown files in your iCloud Drive and other cloud folders in its file tree.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>MacDown2 shows the Markdown files on removable drives in its file tree.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>MacDown2 shows the Markdown files on network volumes in its file tree.</string>
	<!-- Sparkle. Feed URL: UpdaterController.feedURL. SUPublicEDKey is a PLACEHOLDER until the maintainer runs
	     Sparkle's `generate_keys` (private key goes into the login keychain; back it up offline, losing it strands
	     every installed copy) and pastes the printed public key here. While it is a placeholder, update checks are off. -->
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_PUBLIC_KEY_FROM_generate_keys</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
