{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ already points to this MacDown2.0.\n\nRun macdown2 --help in Terminal to see how to use it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已指向这个 MacDown2.0。\n\n在终端里运行 macdown2 --help 查看用法。"
          }
        }
      }
    },
    "%@ copy" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 副本"
          }
        }
      }
    },
    "%@ is a file, not a folder, so the image cannot be saved there." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是一个文件而不是文件夹，图片无法存储到那里。"
          }
        }
      }
    },
    "%@ is %@, not a MacDown2.0 link, so it was left alone. Move or remove it yourself and install again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是%@，不是 MacDown2.0 的链接，所以没有改动。请自行移走或删除后再安装。"
          }
        }
      }
    },
    "%@ is currently %@. Replacing it points it to this MacDown2.0." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 现在是%@。覆盖后它会指向这个 MacDown2.0。"
          }
        }
      }
    },
    "%@ is missing; this build has no command line tool." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到 %@；这个版本不带命令行工具。"
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好"
          }
        }
      }
    },
    "Pasted images are saved in an “images” folder next to the document, so the document needs a place on disk first. Nothing was pasted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴的图片会存储在文稿旁边的“images”文件夹里，所以文稿需要先有一个存放位置。这次没有粘贴任何内容。"
          }
        }
      }
    },
    "Put theme files (.json, the same format as the built-in themes) in this folder and they appear in the list at once. Files that cannot be read are skipped; a theme named like a built-in one is listed with “(User)” after its name." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把主题文件（.json，格式与内置主题相同）放进这个文件夹，它们会立即出现在列表里。无法读取的文件会被跳过；与内置主题同名的主题会在名称后加上“(User)”。"
          }
        }
      }
    },
    "Reveal Themes Folder" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Finder 中显示主题文件夹"
          }
        }
      }
    },
    "Save…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储…"
          }
        }
      }
    },
    "Save the document first" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先存储文稿"
          }
        }
      }
    },
    "Scroll past the end (the last line can reach the middle of the window)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许滚动越过末尾（最后一行可以滚到窗口中间）"
          }
        }
      }
    },
    "%@ · %@ s · PATH has %lld entries" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ s · PATH has %#@entries@"
          },
          "substitutions" : {
            "entries" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg entry"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg entries"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@ s · PATH %3$lld 项"
          }
        }
      }
    },
