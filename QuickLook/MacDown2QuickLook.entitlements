<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read-only, home folder only (includes ~/Library/Mobile Documents = iCloud Drive): lets the preview load images
	     next to the document. A Mac App Store build cannot ship this (PLAN 4.9). -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/</string>
	</array>
	<!-- Read-only access to the app's own preferences domain (no App Group without a signing team), so the preview
	     uses the same render switches, preview style and extension switches as the app. Approved by the user. -->
	<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
	<array>
		<string>io.github.xuanji86.MacDown2</string>
	</array>
</dict>
</plist>
